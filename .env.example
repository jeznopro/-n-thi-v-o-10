# Cổng dịch vụ chạy web server
PORT=5000

# Môi trường chạy (development / production)
NODE_ENV=development

# Khóa bí mật mã hóa JWT Token (Thay đổi khi triển khai thực tế)
JWT_SECRET=essay_system_secure_jwt_secret_key_2026_antigravity

# Dung lượng tải lên tối đa (MB)
MAX_FILE_SIZE_MB=25

# Đường dẫn lưu tệp cơ sở dữ liệu SQLite
DB_PATH=./data/database.sqlite
